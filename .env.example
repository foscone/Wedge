# Copia questo file in `.env` e personalizza i valori.
# `.env` NON deve essere committato (è in .gitignore).

# Password di amministrazione dell'istanza (obbligatoria).
ADMIN_PASSWORD=change-me-admin

# Chiave per firmare i cookie di sessione (obbligatoria, segreta).
# Generala con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-very-long-random-string

# Durata cookie in giorni
SESSION_DAYS=30

# Sub-path se servi sotto https://host/wedge/
ROOT_PATH=

# Percorso host della cartella dati (DB + thumbnails). Cambialo tra locale e
# produzione senza toccare docker-compose.yml. Default: ./data
DATA_DIR_HOST=./data
